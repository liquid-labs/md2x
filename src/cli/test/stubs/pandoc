#!/usr/bin/env bash
#
# Test stub for 'pandoc', used by the md2x CLI test suite. See ../helpers/common.bash.
#
# It performs no conversion. It exists to (a) record what the CLI asked for and
# (b) reproduce the side effects 'src/cli/lib/generate-page.sh' depends on, so the
# CLI survives its own 'set -o errexit':
#
#   * creates the file named by '-o'     -- the conversion output
#   * creates the file named by '--log'  -- 'pandoc-log.log', which the CLI 'rm's
#                                           unless '--keep-intermediate' is given
#
# The invocation (argv[0] basename plus the full argument vector, tab separated) is
# appended to "${MD2X_TEST_STUB_LOG}" when that variable is set.
#
# When "${MD2X_TEST_STUB_CAPTURE_DIR}" is set, the content behind the five
# process-substitution/file arguments the CLI builds ('--metadata-file', '--css', the
# rewritten input document, '--include-before-body', and '--include-after-body') is
# captured there as 'pandoc-<n>-metadata', 'pandoc-<n>-css', 'pandoc-<n>-input',
# 'pandoc-<n>-body-open' and 'pandoc-<n>-body-close', where <n> is the 1-based
# invocation number recorded in 'pandoc.count'. Those fds are readable exactly once, so
# the stub always drains them.
#
# Two env vars let a test drive the stub's own stderr/exit behaviour, following the
# same override convention '../stubs/pdftk' uses for 'MD2X_TEST_STUB_PAGE_COUNT' /
# 'MD2X_TEST_STUB_PAGE_DIMENSIONS':
#
#   * MD2X_TEST_STUB_STDERR    -- content written to the stub's own stderr (default:
#                                  nothing written).
#   * MD2X_TEST_STUB_EXIT_CODE -- exit code the stub returns (default: 0).
#
# Kept compatible with bash 3.2: the test PATH is deliberately minimal.

STUB_NAME='pandoc'

# --- record the invocation ---------------------------------------------------------
if [[ -n "${MD2X_TEST_STUB_LOG:-}" ]]; then
  RECORD="${STUB_NAME}"
  for FIELD in "$@"; do
    RECORD="${RECORD}"$'\t'"${FIELD}"
  done
  printf '%s\n' "${RECORD}" >> "${MD2X_TEST_STUB_LOG}"
fi

# --- parse the arguments we have to act on -----------------------------------------
OUTPUT_FILE=''
LOG_FILE=''
METADATA_FILE=''
CSS_FILE=''
INPUT_FILE=''
TO_FORMAT=''
INCLUDE_BEFORE_FILE=''
INCLUDE_AFTER_FILE=''

ARGS=("$@")
I=0
while (( I < ${#ARGS[@]} )); do
  case "${ARGS[I]}" in
    -o|--output)
      OUTPUT_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --log)
      LOG_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --metadata-file)
      METADATA_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --css)
      CSS_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --to)
      TO_FORMAT="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --include-before-body)
      INCLUDE_BEFORE_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --include-after-body)
      INCLUDE_AFTER_FILE="${ARGS[I + 1]:-}"; I=$(( I + 2 ));;
    --from)
      I=$(( I + 2 ));;
    -*)
      I=$(( I + 1 ));;
    *)
      INPUT_FILE="${ARGS[I]}"; I=$(( I + 1 ));;
  esac
done

# --- drain (and optionally capture) the process-substitution arguments --------------
INPUT_CONTENT=''
METADATA_CONTENT=''
CSS_CONTENT=''
BODY_OPEN_CONTENT=''
BODY_CLOSE_CONTENT=''
[[ -z "${INPUT_FILE}" ]] || ! [[ -r "${INPUT_FILE}" ]] || INPUT_CONTENT="$(cat -- "${INPUT_FILE}")"
[[ -z "${METADATA_FILE}" ]] || ! [[ -r "${METADATA_FILE}" ]] || METADATA_CONTENT="$(cat -- "${METADATA_FILE}")"
[[ -z "${CSS_FILE}" ]] || ! [[ -r "${CSS_FILE}" ]] || CSS_CONTENT="$(cat -- "${CSS_FILE}")"
[[ -z "${INCLUDE_BEFORE_FILE}" ]] || ! [[ -r "${INCLUDE_BEFORE_FILE}" ]] || BODY_OPEN_CONTENT="$(cat -- "${INCLUDE_BEFORE_FILE}")"
[[ -z "${INCLUDE_AFTER_FILE}" ]] || ! [[ -r "${INCLUDE_AFTER_FILE}" ]] || BODY_CLOSE_CONTENT="$(cat -- "${INCLUDE_AFTER_FILE}")"

if [[ -n "${MD2X_TEST_STUB_CAPTURE_DIR:-}" ]] && [[ -d "${MD2X_TEST_STUB_CAPTURE_DIR}" ]]; then
  COUNT_FILE="${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc.count"
  CALL_NUMBER=1
  ! [[ -f "${COUNT_FILE}" ]] || CALL_NUMBER=$(( $(cat "${COUNT_FILE}") + 1 ))
  printf '%s\n' "${CALL_NUMBER}" > "${COUNT_FILE}"

  printf '%s\n' "${INPUT_CONTENT}" > "${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc-${CALL_NUMBER}-input"
  printf '%s\n' "${METADATA_CONTENT}" > "${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc-${CALL_NUMBER}-metadata"
  printf '%s\n' "${CSS_CONTENT}" > "${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc-${CALL_NUMBER}-css"
  printf '%s\n' "${BODY_OPEN_CONTENT}" > "${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc-${CALL_NUMBER}-body-open"
  printf '%s\n' "${BODY_CLOSE_CONTENT}" > "${MD2X_TEST_STUB_CAPTURE_DIR}/pandoc-${CALL_NUMBER}-body-close"
fi

# --- reproduce the side effects the CLI depends on ---------------------------------
if [[ -n "${OUTPUT_FILE}" ]]; then
  {
    printf 'md2x-test-stub: pandoc output\n'
    printf 'to: %s\n' "${TO_FORMAT}"
    printf '%s\n' "${INPUT_CONTENT}"
  } > "${OUTPUT_FILE}"
fi

[[ -z "${LOG_FILE}" ]] || printf 'md2x-test-stub: pandoc log\n' > "${LOG_FILE}"

# --- test-controlled stderr / exit-code overrides -----------------------------------
[[ -z "${MD2X_TEST_STUB_STDERR:-}" ]] || printf '%s\n' "${MD2X_TEST_STUB_STDERR}" >&2

exit "${MD2X_TEST_STUB_EXIT_CODE:-0}"
